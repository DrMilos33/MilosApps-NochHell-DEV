{
  "name": "@milosapps/daylight",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Öffentlicher lokaler Tageslichthelfer für Sonnenaufgang, Sonnenuntergang und bürgerliche Dämmerung.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4319 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "preview:capture": "pnpm build && node scripts/capture-preview.mjs",
    "preview:e2e": "pnpm build && node scripts/e2e-server.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "verify:dev": "pnpm build && node scripts/verify-dev-contract.mjs",
    "verify:external-dev": "node scripts/verify-external-dev.mjs",
    "verify:shell": "node vendor/milosapps-shell/v2/verify.mjs --app-root . --manifest milos-app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:all": "pnpm verify:shell && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "tz-lookup": "6.1.25"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "@types/tz-lookup": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
